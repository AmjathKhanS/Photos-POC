# ===================================
# Photo Viewer Application Configuration
# ===================================

# -----------------------------------
# Server Configuration
# -----------------------------------
NODE_ENV=production
PORT=3002
HOST=0.0.0.0

# -----------------------------------
# CORS Configuration
# -----------------------------------
# Single origin example:
CORS_ORIGIN=https://yourdomain.com

# Multiple origins (comma-separated):
# CORS_ORIGIN=https://app.yourdomain.com,https://admin.yourdomain.com

# Development:
# CORS_ORIGIN=http://localhost:5173

# -----------------------------------
# Photos Directory (REQUIRED)
# -----------------------------------
# Path to your photos directory
# Examples:
#   Linux:   /home/user/photos
#   Windows: C:\Users\user\Photos
#   Docker:  /data/photos
PHOTOS_DIR=/path/to/your/photos

# -----------------------------------
# Database Configuration
# -----------------------------------
# Directory for database files
DB_DIR=/var/lib/photo-viewer/data

# Or specify individual database paths:
# SQLITE_DB_PATH=/var/lib/photo-viewer/data/faces.db
# JSON_DB_PATH=/var/lib/photo-viewer/data/db.json

# -----------------------------------
# Cache Configuration
# -----------------------------------
# Directory for thumbnail cache
CACHE_DIR=/var/cache/photo-viewer

# Cache size limit (in MB, optional)
MAX_CACHE_SIZE_MB=1000

# -----------------------------------
# Python Configuration
# -----------------------------------
# Python executable (python3, python, or full path)
PYTHON_EXECUTABLE=python3

# Path to Python virtual environment (optional)
# If not set, system Python will be used
PYTHON_VENV_PATH=/opt/photo-viewer/venv_onnx

# Path to face service scripts
FACE_SERVICE_PATH=/opt/photo-viewer/server/face-service

# -----------------------------------
# Face Detection Configuration
# -----------------------------------
# Minimum confidence threshold for face detection (0.0-1.0)
# Higher values = fewer false positives but may miss some faces
MIN_FACE_CONFIDENCE=0.95

# ONNX Runtime execution provider
# Options: CPUExecutionProvider (default, CPU-only) or CUDAExecutionProvider (requires GPU)
ONNX_EXECUTION_PROVIDER=CPUExecutionProvider

# Detection size for face detection (pixels)
# Options: 320 (fast, less accurate), 640 (balanced, default), 1024 (slow, most accurate)
# Lower values = faster processing but may miss small/distant faces
ONNX_DET_SIZE=640

# -----------------------------------
# Memory Generation (Cron Schedules)
# -----------------------------------
# Cron schedule for daily "On This Day" memories
# Default: 6:00 AM every day
CRON_DAILY_MEMORIES=0 6 * * *

# Cron schedule for weekly highlight memories
# Default: 7:00 AM every Monday
CRON_WEEKLY_MEMORIES=0 7 * * MON

# Cron schedule for monthly highlight memories
# Default: 8:00 AM on the 1st of every month
CRON_MONTHLY_MEMORIES=0 8 1 * *

# -----------------------------------
# Logging Configuration
# -----------------------------------
# Log level: error, warn, info, debug, trace
LOG_LEVEL=info

# Directory for log files (optional)
# If not set, logs go to stdout/stderr
LOG_DIR=/var/log/photo-viewer

# -----------------------------------
# Performance Configuration
# -----------------------------------
# Maximum thumbnail size (pixels)
MAX_THUMBNAIL_SIZE=200

# Thumbnail JPEG quality (0-100)
THUMBNAIL_QUALITY=60

# Maximum full image size (pixels, for web display)
MAX_IMAGE_SIZE=2400

# Maximum concurrent face detection processes
MAX_CONCURRENT_FACE_DETECTION=4

# -----------------------------------
# Security Configuration
# -----------------------------------
# Enable rate limiting
ENABLE_RATE_LIMITING=true

# Rate limit: max requests per time window
RATE_LIMIT_MAX_REQUESTS=100
RATE_LIMIT_WINDOW_MS=900000

# Enable authentication (future feature)
# ENABLE_AUTH=false
# JWT_SECRET=your-secret-key-here

# -----------------------------------
# Development Configuration
# -----------------------------------
# Enable debug mode (verbose logging)
# DEBUG=false

# Enable hot reload for face models
# HOT_RELOAD_MODELS=false
