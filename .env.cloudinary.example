# Cloudinary Upload Script Environment Variables
# Create a .env file in the root directory with these values

# Get these from: https://cloudinary.com/console

CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

# Local Configuration
PHOTOS_DIR=D:/Photos Ai
# Path to your local photos directory

SQLITE_DB_PATH=D:/Photos Ai/photo-viewer/server/data/faces.db
# Path to your SQLite database
