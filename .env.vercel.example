# Vercel Environment Variables for PhotoViewer Frontend
# Add these in: Vercel Dashboard → Project → Settings → Environment Variables

# Backend API URL (from Railway deployment)
VITE_API_URL=https://your-backend.up.railway.app
# Replace with your actual Railway URL after deploying backend

# Build Configuration (Vercel auto-detects these, but included for clarity)
# VITE_BUILD_OUTPUT=dist
# VITE_ROOT=client
