# Photo Viewer Application Configuration - WINDOWS VERSION

# Server Configuration
NODE_ENV=development
PORT=3002
HOST=localhost

# CORS Configuration (for development)
CORS_ORIGIN=http://localhost:5173

# Photos Directory (REQUIRED) - Windows paths
PHOTOS_DIR=D:/Photos Ai/mobile

# Database Configuration - Windows paths
DB_DIR=D:/Photos Ai/photo-viewer/server/data
SQLITE_DB_PATH=D:/Photos Ai/photo-viewer/server/data/faces.db

# Cache Configuration - Windows paths
CACHE_DIR=D:/Photos Ai/photo-viewer/server/cache

# Python Configuration (Wrapper script for WSL-Windows interop)
PYTHON_EXECUTABLE=D:/Photos Ai/photo-viewer/python-wrapper.sh

# Face Detection Configuration
MIN_FACE_CONFIDENCE=0.95
ONNX_EXECUTION_PROVIDER=CPUExecutionProvider
ONNX_DET_SIZE=640

# Logging Configuration
LOG_LEVEL=info

# Performance Configuration
MAX_THUMBNAIL_SIZE=80
THUMBNAIL_QUALITY=30
MAX_IMAGE_SIZE=2400
MAX_CONCURRENT_FACE_DETECTION=4

# Security Configuration (Relaxed for development)
ENABLE_RATE_LIMITING=true
RATE_LIMIT_MAX_REQUESTS=1000
RATE_LIMIT_WINDOW_MS=900000
