# Photo Viewer Application Configuration (WSL)NODE_ENV=development
PORT=3002
HOST=localhost

# CORS Configuration
CORS_ORIGIN=http://localhost:5173

# Photos Directory (WSL paths)
PHOTOS_DIR=/mnt/d/Photos Ai/mobile

# Database Configuration (accessible by both WSL and Windows Python)
DB_DIR=/mnt/d/Photos Ai/photo-viewer/server/data-wsl
SQLITE_DB_PATH=/mnt/d/Photos Ai/photo-viewer/server/data-wsl/faces.db

# Cache Configuration
CACHE_DIR=/mnt/d/Photos Ai/photo-viewer/server/cache

# Python Configuration (Wrapper script for Windows Python from WSL)
PYTHON_EXECUTABLE=/mnt/d/Photos Ai/photo-viewer/python-wrapper.sh

# Face Detection Configuration
MIN_FACE_CONFIDENCE=0.6
ONNX_EXECUTION_PROVIDER=CPUExecutionProvider
ONNX_DET_SIZE=640

# Logging Configuration
LOG_LEVEL=info

# Performance Configuration
MAX_THUMBNAIL_SIZE=200
THUMBNAIL_QUALITY=60
MAX_IMAGE_SIZE=2400
MAX_CONCURRENT_FACE_DETECTION=4

# Security Configuration (Disabled for local development)
ENABLE_RATE_LIMITING=false
RATE_LIMIT_MAX_REQUESTS=1000000
RATE_LIMIT_WINDOW_MS=900000
