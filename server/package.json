{
  "name": "photo-viewer-server",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "npx tsx watch --env-file=../.env src/index.ts",
    "dev:windows": "npx tsx watch --env-file=../.env src/index.ts",
    "dev:wsl-env": "npx tsx watch --env-file=../.env.wsl src/index.ts",
    "dev:wsl": "SQLITE_DB_PATH=$HOME/photo-viewer-db/faces.db npx tsx watch --env-file=../.env src/index.ts",
    "build": "echo 'Skipping TypeScript compilation - using tsx runtime'",
    "start": "npx tsx src/index.ts"
  },
  "dependencies": {
    "@types/fluent-ffmpeg": "^2.1.28",
    "axios": "^1.6.0",
    "better-sqlite3": "^12.6.2",
    "compression": "^1.8.1",
    "cors": "^2.8.5",
    "exiftool-vendored": "^35.6.0",
    "express": "^4.18.2",
    "express-rate-limit": "^8.2.1",
    "express-slow-down": "^3.0.1",
    "fluent-ffmpeg": "^2.1.3",
    "heic-convert": "^2.1.0",
    "helmet": "^8.1.0",
    "mime-types": "^2.1.35",
    "node-cron": "^3.0.3",
    "sharp": "^0.34.5",
    "sql.js": "^1.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/heic-convert": "^2.1.0",
    "@types/mime-types": "^2.1.4",
    "@types/node": "^20.10.0",
    "@types/node-cron": "^3.0.11",
    "@types/sql.js": "^1.4.9",
    "tsx": "^4.21.0",
    "typescript": "^5.3.3"
  }
