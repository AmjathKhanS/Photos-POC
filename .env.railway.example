# Railway Environment Variables for PhotoViewer Backend
# Copy these to your Railway project's Environment Variables section

# ============ REQUIRED ============

# Storage Mode
PHOTOS_DIR=cloudinary
# Set to "cloudinary" for cloud deployment
# Leave as path (e.g., /app/photos) for local filesystem

# Cloudinary Configuration (Get from: https://cloudinary.com/console)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
# Example: cloudinary://123456789012345:abcdefghijklmnopqrstuvwxyz@your-cloud-name

# Database
SQLITE_DB_PATH=/data/faces.db
DB_DIR=/data

# CORS Origins (Frontend URL)
CORS_ORIGIN=https://your-app.vercel.app
# Replace with your actual Vercel URL after deployment

# ============ OPTIONAL ============

# Server Configuration
PORT=3002
HOST=0.0.0.0
NODE_ENV=production

# Python Environment (for face detection)
PYTHON_EXECUTABLE=python3
PYTHON_VENV_PATH=/app/venv_onnx
FACE_SERVICE_PATH=/app/face-service

# Face Detection
MIN_FACE_CONFIDENCE=0.6

# Rate Limiting
ENABLE_RATE_LIMITING=true
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=1000000

# Thumbnail Configuration
MAX_THUMBNAIL_SIZE=800

# Cron Schedules (UTC time)
CRON_DAILY_MEMORIES=0 6 * * *
CRON_WEEKLY_MEMORIES=0 7 * * MON
CRON_MONTHLY_MEMORIES=0 8 1 * *
